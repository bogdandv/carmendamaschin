---

<section id="reviews" class="rounded-3xl border border-[#273A96]/10 bg-[#f4f7ff] p-8 shadow-[0_16px_40px_rgba(23,37,95,0.06)]">
  <div>
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#F8BF16]">Recenzii</p>
    <h2 class="mt-2 text-3xl font-semibold text-[#15224f]">Ce spun clienții noștri</h2>
  </div>

  <div class="mt-6 flex items-center justify-center gap-4">
    <button 
      type="button" 
      class="flex-shrink-0 rounded-full border border-[#273A96]/20 p-3 text-[#273A96] transition hover:bg-[#dce7ff]" 
      data-carousel-prev
      aria-label="Previous review">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>

    <div class="relative flex-1 overflow-hidden rounded-2xl border border-[#273A96]/10 bg-[#eef4ff]">
      <div 
        class="flex transition-transform duration-500 ease-out" 
        data-carousel-track
        style="transform: translateX(0)">
        {reviews.map((review) => (
          <div class="w-full flex-shrink-0 p-6">
            <div class="flex h-full min-h-[220px] flex-col justify-between">
              <div>
                <p class="text-lg leading-8 text-[#31457f]" data-quote-text data-full-text={review.quote}></p>
                <button
                  type="button"
                  class="mt-3 text-sm font-semibold text-[#273A96] underline underline-offset-2 transition hover:text-[#15224f]"
                  data-read-more
                  data-full-text={review.quote}
                  data-review-name={review.name}
                  hidden
                >
                  Citeste tot
                </button>
              </div>
              <p class="mt-4 font-semibold text-[#15224f]">{review.name}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <button 
      type="button" 
      class="flex-shrink-0 rounded-full border border-[#273A96]/20 p-3 text-[#273A96] transition hover:bg-[#dce7ff]" 
      data-carousel-next
      aria-label="Next review">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
  </div>

  <div class="mt-6 flex items-center justify-center gap-2" data-carousel-dots>
    {reviews.map((_, index) => (
      <button
        type="button"
        class={index === 0 ? "h-2.5 w-2.5 rounded-full bg-[#273A96]" : "h-2.5 w-2.5 rounded-full bg-[#dce7ff]"}
        data-carousel-dot
        aria-label={`Go to review ${index + 1}`}
      />
    ))}
  </div>

  <div class="fixed inset-0 z-50 hidden items-center justify-center bg-[#15224f]/70 p-4" data-review-modal>
    <div class="max-h-[80vh] w-full max-w-2xl overflow-y-auto rounded-3xl bg-white p-6 shadow-2xl">
      <div class="flex items-start justify-between gap-4">
        <h3 class="text-xl font-semibold text-[#15224f]">Recenzie completă</h3>
        <button
          type="button"
          class="rounded-full border border-[#273A96]/20 p-2 text-[#273A96] transition hover:bg-[#dce7ff]"
          data-review-modal-close
          aria-label="Close review"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <p class="mt-4 whitespace-pre-line text-lg leading-8 text-[#31457f]" data-review-modal-body></p>
    </div>
  </div>
</section>

<script>
  const carousel = document.querySelector('[data-carousel-track]');
  const prevBtn = document.querySelector('[data-carousel-prev]');
  const nextBtn = document.querySelector('[data-carousel-next]');
  const dots = Array.from(document.querySelectorAll('[data-carousel-dot]'));
  const container = carousel?.parentElement?.parentElement;
  const modal = document.querySelector('[data-review-modal]');
  const modalBody = modal?.querySelector('[data-review-modal-body]');
  const modalTitle = modal?.querySelector('h3');
  const modalClose = modal?.querySelector('[data-review-modal-close]');
  const quoteElements = Array.from(document.querySelectorAll('[data-quote-text]'));
  const readMoreButtons = Array.from(document.querySelectorAll('[data-read-more]'));

  const getMaxQuoteLength = () => {
    console.log(window.innerWidth)
    if (window.innerWidth < 640) return 170;
    if (window.innerWidth < 740) return 220;
    if (window.innerWidth < 880) return 290;
    if (window.innerWidth < 1024) return 340;
    return 440;
  };

  const getQuotePreview = (quote: string, maxLength: number) => {
    if (quote.length <= maxLength) return quote;

    const truncated = quote.slice(0, maxLength).trimEnd();
    const lastBoundary = Math.max(
      truncated.lastIndexOf('.'),
      truncated.lastIndexOf(','),
      truncated.lastIndexOf('!'),
      truncated.lastIndexOf('?'),
      truncated.lastIndexOf(' '),
    );

    const cutIndex = lastBoundary > 0 ? lastBoundary : truncated.length;
    return `${truncated.slice(0, cutIndex).trimEnd()}...`;
  };

  const updateQuotePreviews = () => {
    const maxLength = getMaxQuoteLength();

    quoteElements.forEach((element) => {
      const fullText = element.getAttribute('data-full-text') || '';
      const shouldTruncate = fullText.length > maxLength;
      const previewText = shouldTruncate ? getQuotePreview(fullText, maxLength) : fullText;
      const button = element.parentElement?.querySelector('[data-read-more]');

      element.textContent = `"${previewText}"`;
      if (button) {
        button.toggleAttribute('hidden', !shouldTruncate);
      }
    });
  };

  const openModal = (text: string, name: string) => {
    if (!modal || !modalBody || !modalTitle) return;

    modalBody.textContent = text;
    modalTitle.textContent = name;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.classList.add('overflow-hidden');
  };

  const closeModal = () => {
    if (!modal) return;

    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.classList.remove('overflow-hidden');
  };

  readMoreButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const fullText = button.getAttribute('data-full-text');
      const reviewName = button.getAttribute('data-review-name');
      if (fullText && reviewName) {
        openModal(fullText, reviewName);
      }
    });
  });

  updateQuotePreviews();
  window.addEventListener('resize', updateQuotePreviews);

  modalClose?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) {
      closeModal();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeModal();
    }
  });

  if (carousel && prevBtn && nextBtn && container) {
    let currentIndex = 0;
    let autoplayInterval: NodeJS.Timeout | null = null;
    let isDragging = false;
    let startX = 0;
    let currentTranslate = 0;
    let prevTranslate = 0;
    let animationID: number | null = null;

    const reviewCount = carousel.children.length;
    const itemWidth = 100;

    const updateCarousel = () => {
      const offset = -currentIndex * itemWidth;
      carousel.style.transform = `translateX(${offset}%)`;

      dots.forEach((dot, index) => {
        dot.classList.toggle('bg-[#273A96]', index === currentIndex);
        dot.classList.toggle('bg-[#dce7ff]', index !== currentIndex);
      });
    };

    const goToSlide = (index: number) => {
      currentIndex = ((index % reviewCount) + reviewCount) % reviewCount;
      updateCarousel();
      resetAutoplay();
    };

    const nextSlide = () => {
      goToSlide(currentIndex + 1);
    };

    const prevSlide = () => {
      goToSlide(currentIndex - 1);
    };

    const startAutoplay = () => {
      if (autoplayInterval) clearInterval(autoplayInterval);
      autoplayInterval = setInterval(nextSlide, 15000);
    };

    const resetAutoplay = () => {
      if (autoplayInterval) clearInterval(autoplayInterval);
      startAutoplay();
    };

    const stopAutoplay = () => {
      if (autoplayInterval) clearInterval(autoplayInterval);
    };

    const getPositionX = (e: MouseEvent | TouchEvent) => {
      return e instanceof TouchEvent ? e.touches[0].clientX : e.clientX;
    };

    const handleDragStart = (e: MouseEvent | TouchEvent) => {
      isDragging = true;
      startX = getPositionX(e);
      prevTranslate = currentIndex * -itemWidth;
      stopAutoplay();

      if (animationID) {
        cancelAnimationFrame(animationID);
      }

      carousel.style.cursor = 'grabbing';
    };

    const handleDragMove = (e: MouseEvent | TouchEvent) => {
      if (!isDragging) return;

      const currentX = getPositionX(e);
      currentTranslate = prevTranslate + (currentX - startX) / container.clientWidth * 100;

      carousel.style.transition = 'none';
      carousel.style.transform = `translateX(${currentTranslate}%)`;
    };

    const handleDragEnd = () => {
      isDragging = false;
      carousel.style.cursor = 'grab';
      carousel.style.transition = '';

      const movedBy = currentTranslate - prevTranslate;

      if (Math.abs(movedBy) > 25) {
        if (movedBy > 0) {
          goToSlide(currentIndex - 1);
        } else {
          goToSlide(currentIndex + 1);
        }
      } else {
        updateCarousel();
      }

      startAutoplay();
    };

    prevBtn.addEventListener('click', prevSlide);
    nextBtn.addEventListener('click', nextSlide);

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => goToSlide(index));
    });

    carousel.addEventListener('mousedown', handleDragStart);
    carousel.addEventListener('mousemove', handleDragMove);
    carousel.addEventListener('mouseup', handleDragEnd);
    carousel.addEventListener('mouseleave', handleDragEnd);

    carousel.addEventListener('touchstart', handleDragStart);
    carousel.addEventListener('touchmove', handleDragMove);
    carousel.addEventListener('touchend', handleDragEnd);

    carousel.style.cursor = 'grab';

    startAutoplay();

    container.addEventListener('mouseenter', stopAutoplay);
    container.addEventListener('mouseleave', startAutoplay);
  }
</script>

<style>
  [data-carousel-track] {
    cursor: grab;
  }

  [data-carousel-track]:active {
    cursor: grabbing;
  }
</style>
