---
const services = [
  "Consultanță personalizată pentru fiecare proiect",
  "Planificare și implementare eficientă",
  "Suport constant și comunicare clară",
  "Rezultate orientate spre satisfacția clientului",
];
---

<section id="services" class="rounded-3xl border border-[#273A96]/10 bg-[#f4f7ff] p-8 shadow-[0_16px_40px_rgba(23,37,95,0.06)]">
  <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#F8BF16]">Servicii</p>
  <h2 class="mt-4 text-3xl font-semibold text-[#15224f]">Ce facem</h2>
  <ul class="mt-6 grid gap-3 md:grid-cols-2">
    {services.map((service) => (
      <li class="rounded-2xl border border-[#273A96]/10 bg-[#eef4ff] px-4 py-3 text-[#31457f]">{service}</li>
    ))}
  </ul>
</section>
