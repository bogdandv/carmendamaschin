---
const services = [
  "Consultanță personalizată pentru fiecare proiect",
  "Planificare și implementare eficientă",
  "Suport constant și comunicare clară",
  "Rezultate orientate spre satisfacția clientului",
];
---

<section id="services" class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
  <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-500">Servicii</p>
  <h2 class="mt-4 text-3xl font-semibold text-slate-900">Ce facem</h2>
  <ul class="mt-6 grid gap-3 md:grid-cols-2">
    {services.map((service) => (
      <li class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-700">{service}</li>
    ))}
  </ul>
</section>
