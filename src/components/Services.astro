---
const services = [
  "Consultanță personalizată pentru fiecare proiect",
  "Planificare și implementare eficientă",
  "Suport constant și comunicare clară",
  "Rezultate orientate spre satisfacția clientului",
];
---

<section id="services" class="rounded-3xl border border-[#3f2560]/10 bg-[#f8f0f8] p-8 shadow-[0_16px_40px_rgba(36,17,47,0.06)]">
  <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#f26622]">Servicii</p>
  <h2 class="mt-4 text-3xl font-semibold text-[#24112f]">Ce facem</h2>
  <ul class="mt-6 grid gap-3 md:grid-cols-2">
    {services.map((service) => (
      <li class="rounded-2xl border border-[#3f2560]/10 bg-[#f8f0f8] px-4 py-3 text-[#4b355d]">{service}</li>
    ))}
  </ul>
</section>
