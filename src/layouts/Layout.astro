---
import "../styles/global.css";
import logo from "../assets/CD1.png";
const { title } = Astro.props;
---

<!doctype html>
<html lang="ro">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href={logo.src} />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body class="bg-[#fdf7e7] text-[#15224f]">
        <header class="border-b border-[#273A96]/15 bg-[#15224f] text-[#fff9e7] backdrop-blur">
            <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
                <a href="/" class="text-lg font-semibold tracking-wide text-white">Cabinet expert Carmen Damaschin</a>
            </div>
        </header>
        <main class="px-4 py-6 sm:px-6 lg:px-8">
            <slot />
        </main>
        <footer class="border-t border-[#273A96]/15 bg-[#15224f] px-6 py-6 text-center text-sm text-[#f7f1d5]">
            <p>© 2026 Cabinet expert Carmen Damaschin</p>
        </footer>
    </body>
</html>